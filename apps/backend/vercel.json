{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/qr-scan",
      "dest": "api/qr-scan.js"
    },
    {
      "src": "/api/done",
      "dest": "api/done.js"
    },
    {
      "src": "/api/get-counts",
      "dest": "api/get-counts.js"
    },
    {
      "src": "/api/reset-counts",
      "dest": "api/reset-counts.js"
    },
    {
      "src": "/api/procesar-encuesta",
      "dest": "api/procesar-encuesta.js"
    },
    {
      "src": "/api/health",
      "dest": "api/get-counts.js"
    }
  ]
}
