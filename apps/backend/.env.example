# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Zoho
ZOHO_SURVEY_URL=https://survey.zoho.com/your-survey-url
ZOHO_WEBHOOK_SECRET=your-secure-random-secret

# Reset de contadores: se envía en la cabecera X-Reset-Secret de POST /api/reset-counts.
# Si no se define, el endpoint responde 503 y no resetea nada (falla cerrado).
RESET_COUNTS_SECRET=your-secure-random-secret

# Environment
NODE_ENV=development
